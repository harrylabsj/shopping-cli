{
  "name": "shopping-cli",
  "version": "3.2.2",
  "description": "Standalone SQLite-backed local commerce AI consultation marketplace runtime.",
  "files": [
    "agents/openai.yaml",
    "docs/agent-protocol.md",
    "docs/architecture.md",
    "docs/migration-from-shopping.md",
    "shopping_cli/**/*.py",
    "plugins/shopping-plugin/index.js",
    "plugins/shopping-plugin/openclaw_compat.js",
    "plugins/shopping-plugin/openclaw.plugin.json",
    "plugins/shopping-plugin/package.json",
    "plugins/shopping-plugin/README.md",
    "references/*.md",
    "scripts/install.sh",
    "scripts/shopping.py",
    "scripts/shopping_agent.py",
    "scripts/shopping_api.py",
    "scripts/shopping_registry.py",
    "scripts/quality.sh",
    "scripts/verify_release.sh",
    "scripts/verify.sh",
    "buyer-demo.json",
    "clawhub.json",
    "marketplace.example.env",
    "pyproject.toml",
    "seller-demo.json",
    "SKILL.md"
  ],
  "bin": {
    "shopping-cli": "scripts/shopping.py",
    "shopping-cli-api": "scripts/shopping_api.py",
    "shopping-cli-agent": "scripts/shopping_agent.py"
  },
  "scripts": {
    "install:agents": "bash scripts/install.sh --both",
    "test": "python3 -m pytest tests/ -q && node --test tests/shopping_plugin.test.mjs && bash scripts/verify.sh",
    "test:plugin": "node --test tests/shopping_plugin.test.mjs",
    "verify": "bash scripts/verify.sh",
    "quality": "bash scripts/quality.sh",
    "verify:release": "bash scripts/verify_release.sh"
  },
  "keywords": [
    "openclaw",
    "hermes",
    "skill",
    "commerce",
    "consultation",
    "marketplace",
    "agent"
  ],
  "author": "harrylabsj",
  "license": "Apache-2.0"
}
