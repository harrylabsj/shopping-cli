include LICENSE
include README.md
include pyproject.toml
recursive-include shopping_cli *.py
recursive-include shopping_cli/contracts *.json
prune tests
prune docs/superpowers
exclude docs/code-review-*.md
exclude shopping-registry.json
exclude shopping-demo.json
exclude seller.json
exclude buyer.json
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
