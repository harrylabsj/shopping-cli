SHOPPING_DEPLOYMENT_PROFILE=production
SHOPPING_API_HOST=0.0.0.0
SHOPPING_API_BIND=127.0.0.1
SHOPPING_API_PORT=8765
SHOPPING_DB=/data/shopping-cli.sqlite
SHOPPING_PUBLIC_BASE_URL=http://localhost:8765
SHOPPING_AGENT_STALE_TTL_SECONDS=60

SHOPPING_ADMIN_TOKEN=replace-with-a-long-random-secret
SHOPPING_BUYER_BOOTSTRAP_TOKEN=replace-with-a-long-random-buyer-secret
SHOPPING_CHANNEL_TOKENS=telegram:replace-with-channel-secret

# This release supports SQLite storage only. Do not set Postgres/RDS URLs yet.
# SHOPPING_DATABASE_URL=sqlite:////data/shopping-cli.sqlite

# kiwi-catalog 门户代理共享密钥：门户后端代免费档商家调本服务时的 Bearer（catalog 为身份权威，对任意 merchant_id 生效）
# KIWI_CATALOG_PROXY_TOKEN=replace-with-a-long-random-proxy-secret
# 免费档商品额度：代理凭据商家最多上架的在售商品数（默认 10，非法/非正数回落 10）
# SHOPPING_FREE_PRODUCT_QUOTA=10
